#!/usr/bin/env bash
set -euo pipefail

seed=$(mktemp -d "$RUNNER_TEMP/dots-first-run.XXXXXXXX")
trap 'rm -rf -- "$seed"
      printf "### First-run smoke test\n\nElapsed time: %ss.\n" "$SECONDS" >> "$GITHUB_STEP_SUMMARY"' EXIT
chmod 755 "$seed"
if [[ ${1:?missing binary or --installer} == --installer ]]; then
    repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
    version=$(sed -n 's/^version = "\([^"]*\)"$/\1/p' "$repo/Cargo.toml")
    release=${2:?missing candidate directory}
    install -m 0644 "$repo/install.sh" "$seed/install.sh"
    install -m 0644 "$release/dots-$version-linux-amd64.tar.gz" "$seed/dots.tar.gz"
    printf '%s\n' "$version" > "$seed/dots-version"
    printf '%s\n' "${MISE_VERSION:?missing pinned mise version}" > "$seed/mise-version"
else
    cp "$(command -v mise)" "$seed/mise"
    install -m 0755 "$1" "$seed/dots"
fi

docker run --rm -i --mount "type=bind,src=$seed,dst=/seed,readonly" \
  alpine:3.23 sh -eu <<'SH'
set -- git ca-certificates
if [ -f /seed/install.sh ]; then set -- "$@" curl openssh-server openssh-client expect; fi
apk add --no-cache "$@"
adduser -D smoke
if [ -f /seed/install.sh ]; then
    # Use real SSH against a private bare repo inside the container.
    printf '%s\n' 'smoke:unused-fixture-password' | chpasswd
    mkdir -p /run/sshd /home/smoke/.ssh
    chmod 700 /home/smoke/.ssh
    ssh-keygen -q -N '' -t ed25519 -f /tmp/dots-ssh-host
    ssh-keygen -q -N '' -t ed25519 -f /home/smoke/.ssh/fixture
    cp /home/smoke/.ssh/fixture.pub /home/smoke/.ssh/authorized_keys
    printf '[127.0.0.1]:2222 %s\n' "$(cut -d ' ' -f 1,2 /tmp/dots-ssh-host.pub)" > /home/smoke/.ssh/known_hosts
    git init --bare --initial-branch=main /srv/dotfiles.git
    chown -R smoke:smoke /home/smoke/.ssh /srv/dotfiles.git
    /usr/sbin/sshd -f /dev/null -o ListenAddress=127.0.0.1 -o PasswordAuthentication=no \
        -o KbdInteractiveAuthentication=no -p 2222 -h /tmp/dots-ssh-host
fi
su -l smoke <<'SMOKE'
set -eu
fixture=$(mktemp -d /tmp/dots-first-run.XXXXXXXX)
machine() {
    unset DOTS_ROOT DOTS_MISE_BIN SETUP_PROFILE SETUP_MACHINE_ID
    unset MISE_GLOBAL_CONFIG_FILE MISE_CONFIG_FILE MISE_TRUSTED_CONFIG_PATHS
    export HOME="$fixture/$1" TMPDIR="$fixture/$1/tmp"
    export XDG_CONFIG_HOME="$HOME/.config" XDG_DATA_HOME="$HOME/.local/share"
    export XDG_STATE_HOME="$HOME/.local/state" XDG_CACHE_HOME="$HOME/.cache"
    export CODEX_HOME="$HOME/.codex" CLAUDE_CONFIG_DIR="$HOME/.claude"
    export MISE_CONFIG_DIR="$XDG_CONFIG_HOME/mise" MISE_SYSTEM_CONFIG_DIR="$fixture/mise-system/config"
    export MISE_DATA_DIR="$XDG_DATA_HOME/mise" MISE_CACHE_DIR="$XDG_CACHE_HOME/mise"
    export MISE_STATE_DIR="$XDG_STATE_HOME/mise" MISE_TMP_DIR="$TMPDIR/mise"
    export MISE_INSTALLS_DIR="$MISE_DATA_DIR/installs" MISE_INSTALL_STORE_DIR="$MISE_DATA_DIR/store"
    export MISE_DOWNLOADS_DIR="$MISE_DATA_DIR/downloads" MISE_PLUGINS_DIR="$MISE_DATA_DIR/plugins"
    export MISE_SHIMS_DIR="$MISE_DATA_DIR/shims" MISE_SYSTEM_DATA_DIR="$fixture/mise-system/data"
    export MISE_SYSTEM_INSTALLS_DIR="$MISE_SYSTEM_DATA_DIR/installs"
    export MISE_SYSTEM_PLUGINS_DIRS="$MISE_SYSTEM_DATA_DIR/plugins"
    export MISE_SYSTEM_SHIMS_DIR="$MISE_SYSTEM_DATA_DIR/shims" MISE_CEILING_PATHS="$fixture"
    mkdir -p "$HOME/.local/bin" "$TMPDIR"
    export PATH="$HOME/.local/bin:/usr/bin:/bin"
    cd "$HOME"
}
machine a
if command -v python3 || command -v node; then
    echo 'Fresh-container fixture unexpectedly contains Python or Node' >&2
    exit 1
fi
if [ -f /seed/install.sh ]; then
    set -o pipefail
    test ! -e "$MISE_CONFIG_DIR"
    if command -v mise || command -v dots; then
        echo 'Fresh-container fixture unexpectedly contains mise or dots' >&2
        exit 1
    fi
    MISE_VERSION=$(cat /seed/mise-version)
    DOTS_VERSION=$(cat /seed/dots-version)
    export MISE_VERSION DOTS_VERSION MISE_SELF_UPDATE_AVAILABLE=0
    curl -fsSL file:///seed/install.sh | sh -s -- --archive /seed/dots.tar.gz > "$fixture/installer.log"
    cat "$fixture/installer.log"
    test "$(cat "$fixture/installer.log")" = 'dots init'
    test ! -e "$MISE_CONFIG_DIR/config.toml"
    test -x "$HOME/.local/bin/mise"
    tar -xOzf /seed/dots.tar.gz bin/dots > "$fixture/expected-dots"
    test "$(readlink "$HOME/.local/bin/dots")" = "$MISE_SHIMS_DIR/dots"
    cmp "$fixture/expected-dots" "$(mise which dots)"
    test "$(sh -c 'command -v dots')" = "$HOME/.local/bin/dots"
    test "$(sh -c 'dots --version')" = "dots $DOTS_VERSION (mise)"
    sh -ec "$(cat "$fixture/installer.log")"

    test "$(git -C "$MISE_CONFIG_DIR" branch --show-current)" = dev
    test "$(git -C "$MISE_CONFIG_DIR" rev-parse main)" = "$(git -C "$MISE_CONFIG_DIR" rev-parse dev)"
    if ! sh -c 'dots up' > "$fixture/up.log"; then cat "$fixture/up.log"; exit 1; fi
    cat "$fixture/up.log"
    grep -Fx 'Sync configuration (no remote configured): skipped' "$fixture/up.log"
    grep -Fx 'Post-update settings checkpoint: skipped' "$fixture/up.log"
    test -x "$(mise which age)"
    test -x "$(mise which gitleaks)"
    test -z "$(git -C "$MISE_CONFIG_DIR" status --porcelain)"

    export GIT_SSH_COMMAND='ssh -i /home/smoke/.ssh/fixture -o UserKnownHostsFile=/home/smoke/.ssh/known_hosts -o StrictHostKeyChecking=yes -o BatchMode=yes'
    export SMOKE_ORIGIN=ssh://smoke@127.0.0.1:2222/srv/dotfiles.git
    git -C "$MISE_CONFIG_DIR" remote add origin "$SMOKE_ORIGIN"
    git -C "$MISE_CONFIG_DIR" push origin main
    awk -v origin="$SMOKE_ORIGIN" '/^\[vars\]$/ { print; print "dots_source_repo = \"" origin "\""; next } 1' \
        "$MISE_CONFIG_DIR/config.toml" > "$fixture/pinned-config"
    cat "$fixture/pinned-config" > "$MISE_CONFIG_DIR/config.toml"
    printf 'first machine bytes\n' > "$fixture/initial"
    cp "$fixture/initial" "$HOME/.dots-smoke"
    dots add "$HOME/.dots-smoke"
    dots sync > "$fixture/publish.log"
    cat "$fixture/publish.log"
    initial=$(git -C /srv/dotfiles.git rev-parse refs/heads/dev)
    git -C /srv/dotfiles.git show "$initial:dotfiles/.dots-smoke" | cmp "$fixture/initial" -

    machine b
    expect <<'EXPECT'
set timeout 180
spawn sh -o pipefail -c {curl -fsSL file:///seed/install.sh | sh -s -- --archive /seed/dots.tar.gz --from "$SMOKE_ORIGIN"}
expect {
    -re {apply [^\r\n]*\.dots-smoke\?} { send -- y; expect { eof {} timeout { exit 1 } } }
    timeout { exit 1 }
    eof {}
}
exit [lindex [wait] 3]
EXPECT
    test "$(git -C "$MISE_CONFIG_DIR" config --local --get remote.origin.url)" = "$SMOKE_ORIGIN"
    test "$(git -C "$MISE_CONFIG_DIR" branch --show-current)" = dev
    cmp "$fixture/initial" "$HOME/.dots-smoke"
    sh -c 'dots up' > "$fixture/b-first-up.log"
    cat "$fixture/b-first-up.log"
    grep -Fx 'Sync configuration: completed' "$fixture/b-first-up.log"

    machine a
    printf 'second machine bytes\n' > "$fixture/updated"
    cat "$fixture/updated" > "$HOME/.dots-smoke"
    dots sync > "$fixture/republish.log"
    cat "$fixture/republish.log"
    updated=$(git -C /srv/dotfiles.git rev-parse refs/heads/dev)
    test "$initial" != "$updated"
    git -C /srv/dotfiles.git show "$updated:dotfiles/.dots-smoke" | cmp "$fixture/updated" -

    machine b
    cmp "$fixture/initial" "$HOME/.dots-smoke"
    sh -c 'dots up' > "$fixture/b-second-up.log"
    cat "$fixture/b-second-up.log"
    grep -Fx 'Sync configuration: completed' "$fixture/b-second-up.log"
    test "$(git -C "$MISE_CONFIG_DIR" rev-parse HEAD)" = "$updated"
    cmp "$fixture/updated" "$HOME/.dots-smoke"
else
    cp /seed/mise /seed/dots "$HOME/.local/bin/"
    dots init </dev/null
    dots up </dev/null
fi
SMOKE
SH
