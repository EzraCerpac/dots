#!/usr/bin/env bash
set -euo pipefail

# Match the PR's changes, including deletions and both sides of renames.
case "$EVENT" in
  pull_request) range="$BASE...$HEAD_SHA" ;;
  push)
    if [[ "$BASE" =~ ^0+$ ]]; then
      BASE=$(git hash-object -w -t tree /dev/null)
    elif ! git cat-file -e "$BASE^{commit}" 2>/dev/null; then
      git fetch --no-tags origin "$BASE"
    fi
    range="$BASE..$HEAD_SHA"
    ;;
  *) echo "Unsupported CI event: $EVENT" >&2; exit 2 ;;
esac

docs=false rust=false legacy=false other=false full=false
if [[ "$EVENT" == push || "$BASE_REF" == main ]]; then
  full=true
fi

paths=$(mktemp)
trap 'rm -f "$paths"' EXIT
git diff --name-only --no-renames -z "$range" -- > "$paths"
while IFS= read -r -d '' path; do
  case "$path" in
    # The legacy init contract compares its generated README to this template.
    init/README.md) legacy=true ;;
    *.md|docs/*|plan/*|LICENSE) docs=true ;;
    .github/workflows/test.yml|.github/workflows/release.yml|\
    bin/*|lib/*|tasks/*|bootstrap/*|dots-up/*|completions/*|packaging/*|\
    tests/run|tests/test_*.py|tests/test_*.mjs|tests/lib/*|tests/dots-up-*.sh)
      legacy=true ;;
    init/*|tests/fixtures/*)
      rust=true
      legacy=true ;;
    src/*|tests/*|Cargo.toml|Cargo.lock|mise.toml|.mise/*|.cargo/*|.config/nextest.toml|.github/*)
      rust=true ;;
    *) other=true ;;
  esac
done < "$paths"

non_docs=false
if "$rust" || "$legacy" || "$other"; then
  non_docs=true
fi
printf 'docs=%s\nrust=%s\nlegacy=%s\nother=%s\nnon_docs=%s\nfull=%s\n' \
  "$docs" "$rust" "$legacy" "$other" "$non_docs" "$full" >> "$GITHUB_OUTPUT"
