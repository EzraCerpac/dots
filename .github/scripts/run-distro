#!/usr/bin/env bash
set -euo pipefail

distro=${1:?expected Fedora, Arch, or Alpine}
case "$distro" in
    Fedora) image=fedora:latest ;;
    Arch) image=archlinux:base ;;
    Alpine) image=alpine:3.23 ;;
    *) echo "Unexpected distro: $distro" >&2; exit 2 ;;
esac

workspace=$(pwd -P)
# Keep the paths embedded by Cargo and run test binaries inside this distro.
container=$(docker run --rm -dit --workdir "$workspace" \
    --mount "type=bind,src=$workspace,dst=$workspace,readonly" \
    --mount "type=bind,src=$RUNNER_TEMP/dots-scenario-tools/bin,dst=/dots-tools,readonly" \
    -e "PATH=$workspace/.github/scripts/scenario-bin:/dots-tools:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    "$image" sh)
trap 'docker rm -f "$container" >/dev/null' EXIT
case "$distro" in
    Fedora) docker exec "$container" dnf install -y bash zsh fish git jq ;;
    Arch) docker exec "$container" pacman -Syu --noconfirm --needed bash zsh fish git jq ;;
    Alpine) docker exec "$container" apk add --no-cache bash zsh fish git jq ;;
esac
export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUNNER="docker exec $container"
bash .github/scripts/run-native-tests x86_64-unknown-linux-musl
