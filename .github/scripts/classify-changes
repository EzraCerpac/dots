#!/usr/bin/env bash
set -euo pipefail

full=false
if [[ "$EVENT" == push || "$REF_TYPE" == tag ]]; then
    full=true
fi
# Use the same platform selection for packaging and install verification.
matrix=$(jq -cn --argjson full "$full" '
    [
        {runner:"ubuntu-24.04", target:"x86_64-unknown-linux-musl", platform:"linux-amd64"},
        {runner:"ubuntu-24.04-arm", target:"aarch64-unknown-linux-musl", platform:"linux-arm64"}
    ] as $linux |
    [
        {runner:"macos-26", target:"aarch64-apple-darwin", platform:"darwin-arm64"},
        {runner:"macos-15-intel", target:"x86_64-apple-darwin", platform:"darwin-amd64"}
    ] as $mac_all |
    (if $full then $mac_all else $mac_all[:1] end) as $mac |
    {
        linux: {include:$linux},
        mac: {include:$mac},
        shards: {include:[$mac[] | . + {shard:1}, . + {shard:2}]},
        oracle: {include:(if $full then [$linux[0], $mac_all[0]] else [] end)},
        packages: {include:(if $full then $linux + $mac else $linux end)}
    }
')
printf 'full=%s\nmatrix=%s\n' "$full" "$matrix" >> "$GITHUB_OUTPUT"

# A release always runs every gate, independent of the tag's diff.
if [[ "$REF_TYPE" == tag ]]; then
    echo 'code=true' >> "$GITHUB_OUTPUT"
    exit
fi

case "$EVENT" in
    pull_request) range="$BASE...$HEAD_SHA" ;;
    push)
        if [[ "$BASE" =~ ^0+$ ]]; then
            BASE=$(git hash-object -w -t tree /dev/null)
        elif ! git cat-file -e "$BASE^{commit}" 2>/dev/null; then
            git fetch --no-tags origin "$BASE"
        fi
        range="$BASE..$HEAD_SHA"
        ;;
    *) echo "Unsupported CI event: $EVENT" >&2; exit 2 ;;
esac

paths=$(mktemp)
trap 'rm -f "$paths"' EXIT
git diff --name-only --no-renames -z "$range" -- > "$paths"
while IFS= read -r -d '' path; do
    case "$path" in
        *.md|docs/*|plan/*|LICENSE) ;;
        *) echo 'code=true' >> "$GITHUB_OUTPUT"; exit ;;
    esac
done < "$paths"
echo 'code=false' >> "$GITHUB_OUTPUT"
