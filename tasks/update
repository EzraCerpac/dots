#!/usr/bin/env bash
# MISE description="Checkpoint settings and update declared packages, tools, exceptions, configuration hooks, and mise"
set -euo pipefail

source "$(dirname "$0")/../lib/setup-common.sh"
source "$(dirname "$0")/../lib/dots-packages.sh"
source "$(dirname "$0")/../lib/dots-up-events.sh"
source "$(dirname "$0")/../lib/dots-manager.sh"
include_mas=0
plain_output="${DOTS_UP_PLAIN:-0}"
verbose_output="${DOTS_UP_VERBOSE:-0}"
for argument in "$@"; do
    case "$argument" in
        --mas) include_mas=1 ;;
        --plain) plain_output=1 ;;
        --verbose) verbose_output=1 ;;
        -h|--help)
            printf 'Usage: dots up [--mas] [--plain] [--verbose]\n\nMac App Store updates are skipped by default.\n--mas includes them on macOS hosts that declare mas: packages.\n'
            exit 0
            ;;
        *) setup_error "unknown update option: $argument (usage: dots up [--mas])"; exit 2 ;;
    esac
done
setup_init || exit $?
# This run keeps using the manager it started from (DOTS_HOME, a versioned
# directory for mise and Homebrew installs), even when a stage upgrades dots.
# mise keeps replaced versions (upgrade --no-prune below), but Homebrew's
# install cleanup would delete the old keg mid-run; dots up removes no
# installed version, so keep Homebrew's cleanup for later as well.
export HOMEBREW_NO_INSTALL_CLEANUP=1
if [[ "$plain_output" -eq 1 ]] && ! dots_up_event_sink_enabled && [[ -z "${DOTS_UP_RUN_DIR:-}" ]]; then
    state_root="${XDG_STATE_HOME:-${HOME:?HOME must be set}/.local/state}/dots/up"
    mkdir -p "$state_root" || exit 1
    chmod 700 "$state_root" || exit 1
    DOTS_UP_RUN_DIR="$state_root/$(date -u +%Y%m%dT%H%M%SZ)-$$"
    mkdir -p "$DOTS_UP_RUN_DIR/stages" || exit 1
    chmod 700 "$DOTS_UP_RUN_DIR" "$DOTS_UP_RUN_DIR/stages" || exit 1
    : > "$DOTS_UP_RUN_DIR/.active"
    chmod 600 "$DOTS_UP_RUN_DIR/.active"
    export DOTS_UP_RUN_DIR
fi
if dots_up_event_sink_enabled && [[ -z "${DOTS_UP_EVENT_JQ:-}" ]]; then
    DOTS_UP_EVENT_JQ="$(setup_mise which jq 2>/dev/null || true)"
    export DOTS_UP_EVENT_JQ
fi

emit_event() {
    dots_up_emit_event "$1"
}
event_json() {
    dots_up_event_json "$@"
}
start_event_stage() {
    local id="$1" group="$2" label="$3" terminal="${4:-hidden}"
    emit_event "$(event_json --arg id "$id" --arg group "$group" --arg label "$label" --arg terminal "$terminal" '{v:1,kind:"stage_start",id:$id,group:$group,label:$label,terminal:$terminal}')"
    if [[ "$terminal" == handoff && -n "${DOTS_UP_ACK_FD:-}" ]]; then
        local acknowledgement
        IFS= read -r -u "$DOTS_UP_ACK_FD" acknowledgement || return 1
        [[ "$acknowledgement" == "go:$id" ]] || return 1
    fi
}
event_group() {
    case "$1" in
        "Sync configuration"|*settings*checkpoint*) printf 'Source & settings' ;;
        "new Homebrew formulae"|"Homebrew formulae"|"new Homebrew casks"|"Homebrew casks"|"Mac App Store tool"|"Mac App Store authorization"|"Mac App Store result"|*"declared host packages"*) printf 'Packages' ;;
        "newly declared mise tools"|"declared mise tools"|"standalone mise"|"dots manager") printf 'Tools' ;;
        "installer exception"*) printf 'Managed apps/local builds' ;;
        *) printf 'Final checks' ;;
    esac
}
snapshot_stage() {
    local group="$1" label="$2" manager="${3:-}" data
    if [[ "$label" == 'standalone mise' ]]; then
        local version
        version="$("$(resolve_mise_bin)" --version 2>/dev/null)" || return 1
        [[ -n "$version" ]] || return 1
        setup_mise exec -- jq -cn --arg value "$version" '[{item:"mise",value:$value}]'
        return
    fi
    case "$group" in
        Tools)
            data="$(setup_mise ls --json 2>/dev/null)" || return 1
            printf '%s' "$data" | setup_mise exec -- jq -ce '
                [to_entries[] as $tool | $tool.value[]?
                    | select(.active == true and .installed == true and (.version | type == "string"))
                    | {item:$tool.key,value:.version}]
                | sort_by(.item)
            ' 2>/dev/null
            ;;
        Packages)
            [[ -n "$manager" ]] || { printf '[]'; return; }
            data="$(package_status "$manager")" || return 1
            printf '%s\n' "$data" | setup_mise exec -- jq -ce --arg manager "$manager" '
                [.[$manager].packages[]?
                    | select((.installed_version // "") != "")
                    | {item:($manager + ":" + .package), value:.installed_version}]
                | sort_by(.item)
            '
            ;;
        *) printf '[]' ;;
    esac
}
emit_snapshot_changes() {
    local stage="$1" before="$2" after="$3" changes
    dots_up_event_sink_enabled || return 0
    changes="$(setup_mise exec -- jq -cn --arg stage "$stage" --argjson before "${before:-[]}" --argjson after "${after:-[]}" '
        ($before | map({key:.item,value:.value}) | from_entries) as $b |
        ($after | map({key:.item,value:.value}) | from_entries) as $a |
        ((($b | keys) + ($a | keys)) | unique[]) as $item |
        select(($b[$item] // null) != ($a[$item] // null)) |
        {v:1,kind:"change",stage:$stage,item:$item,action:(if ($b | has($item) | not) then "installed" elif ($a | has($item) | not) then "removed" else "updated" end),before:($b[$item] // "not installed"),after:($a[$item] // "not installed")}
    ' 2>/dev/null || true)"
    [[ -n "$changes" ]] || return 0
    while IFS= read -r event; do [[ -n "$event" ]] && emit_event "$event"; done <<< "$changes"
}
# Hooks and installer exception recipes may append "ITEM<TAB>BEFORE<TAB>AFTER"
# lines to $DOTS_CHANGES; each becomes a change in its stage report, like the
# package and tool changes above. An empty or "not installed" side marks an
# installation or removal; the same value on both sides marks a rebuild.
change_action() {
    local before="$1" after="$2" before_missing=0 after_missing=0
    [[ -n "$before" && "$before" != 'not installed' ]] || before_missing=1
    [[ -n "$after" && "$after" != 'not installed' ]] || after_missing=1
    if [[ "$before_missing" -eq 1 && "$after_missing" -eq 0 ]]; then printf installed
    elif [[ "$before_missing" -eq 0 && "$after_missing" -eq 1 ]]; then printf removed
    elif [[ "$before_missing" -eq 0 && "$before" != "$after" ]]; then printf updated
    else printf changed
    fi
}
emit_reported_changes() {
    local stage="$1" file="$2" line item rest before after ignored=0
    [[ -s "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -n "$line" ]] || continue
        item="${line%%$'\t'*}"
        rest="${line#*$'\t'}"
        before="${rest%%$'\t'*}"
        after="${rest#*$'\t'}"
        if [[ "$line" != *$'\t'*$'\t'* || "$after" == *$'\t'* || -z "$item" ]]; then
            ignored=$((ignored + 1))
            continue
        fi
        emit_event "$(event_json --arg stage "$stage" --arg item "$item" --arg action "$(change_action "$before" "$after")" --arg before "$before" --arg after "$after" '{v:1,kind:"change",stage:$stage,item:$item,action:$action,before:$before,after:$after}')"
    done < "$file"
    if [[ "$ignored" -gt 0 ]]; then
        printf 'Note: ignored %s malformed DOTS_CHANGES line(s); expected ITEM<TAB>BEFORE<TAB>AFTER.\n' "$ignored"
        dots_up_emit_notice info "Ignored $ignored malformed change line(s) from this stage" "Write ITEM<TAB>BEFORE<TAB>AFTER lines to DOTS_CHANGES" "$stage"
    fi
}

if dots_up_event_sink_enabled && [[ -z "${DOTS_UP_RUN_STARTED:-}" ]]; then
    export DOTS_UP_RUN_STARTED=1
    emit_event "$(event_json --arg profile "$SETUP_PROFILE" --arg host "$(hostname -s 2>/dev/null || uname -n)" '{v:1,kind:"run_start",profile:$profile,host:$host}')"
fi

# Validate the selected config without installing tools. A failed check can also
# indicate a trust or other loading error, so preserve mise's diagnostic.
validate_update_config() {
    local diagnostic
    if diagnostic="$(setup_mise config ls 2>&1)"; then
        return 0
    fi
    start_event_stage update-config 'Source & settings' 'Validate update configuration'
    setup_error 'cannot load update configuration; dependent updates stopped. Review the diagnostic and rerun dots up.'
    printf '%s\n' "$diagnostic" >&2
    emit_event "$(event_json --arg id update-config --arg summary 'Cannot load update configuration; dependent updates stopped' --arg action 'Review the configuration diagnostic and rerun dots up' '{v:1,kind:"stage_end",id:$id,status:"failed",exit_code:1,summary:$summary,action:$action}')"
    return 1
}

abort_invalid_config() {
    # The optional App Store installer may already be running independently.
    # Wait for it and emit its outcome before returning control to the caller.
    if [[ -n "${app_store_pid:-}" ]]; then
        finish_app_store_packages || true
    fi
    exit 1
}

validate_update_config || abort_invalid_config

# Sync first, then reload so maintenance runs from the synced configuration.
# Whatever the sync outcome, the remaining stages still run; its attention
# lines are repeated in the final summary.
if [[ "${DOTS_SOURCE_SYNC_DONE:-0}" != 1 ]]; then
    sync_result=0
    if [[ "$plain_output" -eq 1 ]]; then printf 'Working: Sync configuration\n'; fi
    if dots_up_event_sink_enabled; then
        start_event_stage source-sync 'Source & settings' 'Sync configuration' hidden
    fi
    # setup_mise turns off auto-install for its own mise call only. Sync applies
    # the incoming configuration, whose hooks may run a tool it newly pins with
    # `mise x`, so sync keeps the caller's setting, as `dots sync` does.
    restore=(-u MISE_AUTO_INSTALL)
    [[ -z "${MISE_AUTO_INSTALL+set}" ]] || restore=("MISE_AUTO_INSTALL=$MISE_AUTO_INSTALL")
    sync_output="$(setup_mise exec -- env "${restore[@]}" node "$DOTS_HOME/lib/source-repo.mjs" sync "$SETUP_ROOT" 2>&1)" || sync_result=$?
    printf '%s\n' "$sync_output"
    if [[ -n "${DOTS_UP_RUN_DIR:-}" ]]; then
        # The log keeps the output, not the event records it carries to the dashboard.
        (umask 077; printf '%s\n' "$sync_output" | LC_ALL=C sed $'s/\036dots-up\\/1:[^\037]*\037//g' > "$DOTS_UP_RUN_DIR/stages/source-sync.log") || true
    fi
    # Attention: a header that did not complete, an uppercase notice line, or a
    # crash, each with the deeper-indented output lines that explain it.
    sync_attention="$(printf '%s\n' "$sync_output" | awk '
        /^dots sync: (stopped|skipped|failed)/ || /^  [A-Z][A-Z ]+[ :(]/ { keep = 1; print; next }
        keep && /^    / { print; next }
        { keep = 0 }')"
    if [[ "$sync_result" -ne 0 && -z "$sync_attention" ]]; then sync_attention="dots sync exited $sync_result"; fi
    if [[ -n "$sync_attention" ]]; then
        if [[ "$plain_output" -eq 1 ]]; then printf 'Result: needs attention\n'; fi
        # One issue per attention line, with the output under it and the one
        # command to run next; the first ends the stage, the rest are notices.
        while IFS= read -r sync_event; do emit_event "$sync_event"; done < <(event_json --arg text "$sync_attention" '
            [$text | split("\n")[] | select(length > 0)]
            | reduce .[] as $line ([]; if ($line | startswith("    ")) then .[-1].detail += [$line[4:]]
                                       else . + [{summary: ($line | ltrimstr("  ")), detail: []}] end)
            | to_entries[] | .key as $first | .value
            | {v:1, summary, detail: (.detail | join("\n")),
               action: (if (.summary | startswith("APPLY FAILED") and endswith("then run dots apply")) then "dots apply" else "dots sync" end)}
            | if $first == 0 then . + {kind:"stage_end", id:"source-sync", label:"Sync configuration", status:"attention", exit_code:0}
              else . + {kind:"notice", severity:"attention", stage:"source-sync"} end')
    else
        if [[ "$plain_output" -eq 1 ]]; then printf 'Result: completed\n'; fi
        emit_event "$(event_json --arg id source-sync --arg summary "${sync_output%%$'\n'*}" '{v:1,kind:"stage_end",id:$id,label:"Sync configuration",status:"ok",exit_code:0,summary:$summary}')"
    fi
    export DOTS_SOURCE_SYNC_DONE=1 DOTS_SOURCE_SYNC_ATTENTION="$sync_attention"
    exec "$(resolve_mise_bin)" -C "$SETUP_ROOT" -E "$SETUP_ENVIRONMENTS" exec -- bash "$DOTS_HOME/tasks/update" "$@"
fi

failures=()
deferred=()
attention_logs=()
# run_stage LABEL [--terminal-handoff] [--package-manager MANAGER | --hook | --changes] COMMAND...
# A --hook stage follows the hook contract: exit 3 is deferred (needs
# attention), 4 is skipped, and any other nonzero status is a failure.
# --hook and --changes stages get a DOTS_CHANGES file for their change reports.
run_stage() {
    local label="$1"
    shift
    local terminal=hidden hook=0 reports_changes=0 manager=""
    if [[ "${1:-}" == --terminal-handoff ]]; then terminal=handoff; shift; fi
    if [[ "${1:-}" == --package-manager ]]; then manager="$2"; shift 2
    elif [[ "${1:-}" == --hook ]]; then hook=1 reports_changes=1; shift
    elif [[ "${1:-}" == --changes ]]; then reports_changes=1; shift; fi
    local event_id="${label//[^a-zA-Z0-9]/-}"
    local group=Hooks
    [[ "$hook" -eq 1 ]] || group="$(event_group "$label")"
    local before_snapshot='[]' after_snapshot='[]' before_valid=0 after_valid=0
    local stage_log="" handoff_failed=0
    if dots_up_event_sink_enabled; then
        emit_event "$(event_json --arg id "$event_id" --arg group "$group" --arg label "$label" --arg terminal "$terminal" '{v:1,kind:"stage_start",id:$id,group:$group,label:$label,terminal:$terminal}')"
        if [[ "$terminal" == handoff && -n "${DOTS_UP_ACK_FD:-}" ]]; then
            local acknowledgement
            if ! IFS= read -r -u "$DOTS_UP_ACK_FD" acknowledgement; then
                setup_error "terminal handoff did not complete for $label"
                handoff_failed=1
            elif [[ "$acknowledgement" != "go:$event_id" ]]; then
                setup_error "invalid terminal handoff for $label"
                handoff_failed=1
            fi
        fi
    fi
    if dots_up_event_sink_enabled; then
        before_snapshot="$(snapshot_stage "$group" "$label" "$manager" 2>/dev/null)" && [[ "$before_snapshot" == \[*\] ]] && before_valid=1 || true
    fi
    if [[ "$plain_output" -eq 1 ]] && ! dots_up_event_sink_enabled && [[ -n "${DOTS_UP_RUN_DIR:-}" ]]; then
        stage_log="$DOTS_UP_RUN_DIR/stages/$event_id.log"
        if ! { : > "$stage_log" && chmod 600 "$stage_log"; }; then
            printf 'Warning: could not create the %s log; showing its output directly.\n' "$label" >&2
            stage_log=""
        fi
    fi
    if [[ "$plain_output" -eq 1 ]]; then printf 'Working: %s\n' "$label"; else printf '\n== %s ==\n' "$label"; fi
    local result=0 changes_file="" action=""
    if [[ "$reports_changes" -eq 1 ]]; then
        if changes_file="$(mktemp "${TMPDIR:-/tmp}/dots-changes.XXXXXX")"; then
            export DOTS_CHANGES="$changes_file"
        else
            changes_file=""
        fi
    fi
    if [[ "$handoff_failed" -eq 1 ]]; then
        result=1
    elif [[ -n "$stage_log" && ( "$terminal" != handoff || ! -t 0 || ! -t 1 ) ]]; then
        "$@" > "$stage_log" 2>&1 || result=$?
    else
        "$@" || result=$?
    fi
    if [[ -n "$changes_file" ]]; then
        unset DOTS_CHANGES
        emit_reported_changes "$event_id" "$changes_file"
        rm -f -- "$changes_file"
    fi
    if dots_up_event_sink_enabled; then
        after_snapshot="$(snapshot_stage "$group" "$label" "$manager" 2>/dev/null)" && [[ "$after_snapshot" == \[*\] ]] && after_valid=1 || true
        if [[ "$before_valid" -eq 1 && "$after_valid" -eq 1 ]]; then
            emit_snapshot_changes "$event_id" "$before_snapshot" "$after_snapshot"
        fi
    fi
    if [[ "$result" -eq 0 ]]; then
        local summary="completed"
        printf 'Result: completed\n'
        if dots_up_event_sink_enabled; then
            emit_event "$(event_json --arg id "$event_id" --arg label "$label" --arg summary "$summary" '{v:1,kind:"stage_end",id:$id,label:$label,status:"ok",exit_code:0,summary:$summary}')"
        fi
    elif [[ "$hook" -eq 1 && ( "$result" -eq 3 || "$result" -eq 4 ) ]]; then
        local status=skipped summary=skipped
        if [[ "$result" -eq 3 ]]; then
            status=attention summary="deferred; needs attention"
            deferred+=("$label")
            action="Do what the hook's output asks, then run dots up again"
        fi
        printf 'Result: %s\n' "$summary"
        if [[ "$status" == attention && -n "$stage_log" ]]; then
            printf 'Recent output:\n'
            tail -n 30 "$stage_log" || true
            printf 'Full log: %s\n' "$stage_log"
            attention_logs+=("$label: $stage_log")
        fi
        if dots_up_event_sink_enabled; then
            emit_event "$(event_json --arg id "$event_id" --arg label "$label" --arg status "$status" --arg summary "$summary" --arg action "${action:-}" --argjson code "$result" '{v:1,kind:"stage_end",id:$id,label:$label,status:$status,exit_code:$code,summary:$summary,action:$action}')"
        fi
        return 0
    else
        printf 'Result: failed (exit %s)\n' "$result"
        if [[ -n "$stage_log" ]]; then
            printf 'Recent output:\n' >&2
            tail -n 30 "$stage_log" >&2 || true
            printf 'Full log: %s\n' "$stage_log" >&2
            attention_logs+=("$label: $stage_log")
        fi
        failures+=("$label")
        if dots_up_event_sink_enabled; then
            emit_event "$(event_json --arg id "$event_id" --arg label "$label" --arg summary "failed (exit $result)" --arg action 'Fix the error above, then run dots up' --argjson code "$result" '{v:1,kind:"stage_end",id:$id,label:$label,status:"failed",exit_code:$code,summary:$summary,action:$action}')"
        fi
        validate_update_config || abort_invalid_config
        return "$result"
    fi
    return 0
}

# A checkpoint saves every tracked file; refuse one that is not encrypted.
settings_checkpoint() {
    setup_tracked_history_paths setup_mise >/dev/null || return $?
    setup_mise bootstrap dotfiles save
}

if ! run_stage 'Pre-update settings checkpoint' settings_checkpoint; then
    setup_error "pre-update settings checkpoint failed; no updates were started"
    exit 1
fi

app_store_pid=""
app_store_log=""
app_store_authorized=0
prepare_app_store_tool() {
    setup_mise bootstrap packages apply --manager brew --yes brew:mas || return $?
    setup_mise bootstrap packages upgrade --manager brew --yes brew:mas
}

authorize_app_store_packages() {
    if sudo -n true >/dev/null 2>&1; then
        app_store_authorized=1
        return 0
    fi
    if [[ -t 0 && -t 1 ]]; then
        if sudo -v; then
            app_store_authorized=1
            return 0
        fi
        emit_event "$(event_json --arg summary 'Mac App Store updates deferred; administrator authorization was not granted.' '{v:1,kind:"notice",severity:"attention",summary:$summary}')"
        printf 'Deferred: Mac App Store updates need administrator authorization.\n'
        return 0
    fi
    emit_event "$(event_json --arg summary 'Mac App Store updates deferred; administrator authorization needs an interactive terminal.' '{v:1,kind:"notice",severity:"attention",summary:$summary}')"
    printf 'Deferred: App Store updates need administrator authorization; run dots up --mas in an interactive terminal.\n'
    return 0
}

start_app_store_packages() {
    [[ "$app_store_authorized" -eq 1 ]] || return 0
    if [[ -n "${DOTS_UP_RUN_DIR:-}" ]]; then
        app_store_log="$DOTS_UP_RUN_DIR/app-store.log"
        : > "$app_store_log"
        chmod 600 "$app_store_log"
    else
        app_store_log="$(mktemp "${TMPDIR:-/tmp}/dots-mas-update.XXXXXX")" || return $?
        chmod 600 "$app_store_log"
    fi
    emit_event "$(event_json --arg id mac-app-store --arg group Packages --arg label 'Mac App Store updates' --arg status running --arg log_path "$app_store_log" '{v:1,kind:"app_store_start",id:$id,group:$group,label:$label,status:$status,log_path:$log_path}')"
    (
        routine_packages apply --manager mas --yes "$@" &&
            routine_packages upgrade --manager mas --yes "$@"
    ) > "$app_store_log" 2>&1 &
    app_store_pid=$!
    printf 'Mac App Store updates started.\n'
}

finish_app_store_packages() {
    [[ -n "$app_store_pid" ]] || return 0
    printf 'Waiting for Mac App Store updates...\n'
    local result=0
    wait "$app_store_pid" || result=$?
    local status=ok summary=completed
    if [[ "$result" -ne 0 ]]; then
        status=failed
        summary="failed (exit $result)"
    fi
    emit_event "$(event_json --arg id mac-app-store --arg status "$status" --arg summary "$summary" --argjson code "$result" --arg log_path "$app_store_log" '{v:1,kind:"app_store_end",id:$id,status:$status,exit_code:$code,summary:$summary,log_path:$log_path}')"
    if [[ "$verbose_output" -eq 1 ]]; then cat "$app_store_log"; fi
    app_store_pid=""
    return "$result"
}

# With bare package keys, keep all eligible candidates in scope so mise
# can still resolve them in its configured preference order.
package_status() {
    local scope="$1"
    [[ "$has_bare_packages" -eq 0 ]] || scope="$active_package_scope"
    MISE_SYSTEM_PACKAGES_MANAGERS="$scope" setup_mise bootstrap packages status --json
}

routine_packages() {
    MISE_SYSTEM_PACKAGES_MANAGERS="$active_package_scope" setup_mise bootstrap packages "$@"
}

# An exception owns a package it holds. When filtering a manager's
# requests, explicit mise specs preserve only unpinned, present declarations.
select_package_specs() {
    local status="$1" manager="$2" mode="$3" rows package version desired self_updating=""
    if [[ "$mode" == cask-upgrade ]]; then
        self_updating="$(setup_dots_list dots_self_updating_casks optional)" || return $?
    fi
    rows="$(printf '%s\n' "$status" | setup_mise exec -- jq -r --arg manager "$manager" \
        --arg mode "$mode" --arg skip "$self_updating" '
        ($skip | split("\n")) as $skip
        | .[$manager].packages[]?
        | select($mode != "cask-upgrade" or
            (.state == "installed" and .auto_updates != true and (.package as $name | $skip | index($name) == null)))
        | [.package, .requested_version, .desired_state] | @tsv
    ')" || return $?
    package_specs=()
    restricted=0
    uses_native_options=0
    [[ -n "$rows" ]] || return 0
    while IFS=$'\t' read -r package version desired; do
        setup_exception_holder "$manager:$package" "$SETUP_PROFILE" || return $?
        if [[ -n "$SETUP_HOLDER" ]]; then
            restricted=1
        elif [[ "$version" == latest && "$desired" == present ]]; then
            package_specs+=("$manager:$package")
        else
            uses_native_options=1
        fi
    done <<< "$rows"
}

# Native manager-only passes keep package pins and absent declarations. Where
# a hold requires explicit selection, reject a conflicting declaration set
# before doing anything that would ignore those native options.
select_routine_packages() {
    local uses_native_options
    select_package_specs "$1" "$2" apply || return $?
    if [[ "$restricted" -eq 0 ]]; then
        package_specs=()
    elif [[ "$uses_native_options" -eq 1 ]]; then
        setup_error "remove held $2 packages from [bootstrap.packages] so other declarations can keep their requested versions and states"
        return 2
    fi
}

upgrade_homebrew_casks() {
    local status restricted uses_native_options
    local -a package_specs
    status="$(package_status brew-cask)" || return $?
    select_package_specs "$status" brew-cask cask-upgrade || return $?
    if [[ ${#package_specs[@]} -gt 0 ]]; then
        routine_packages upgrade --manager brew-cask --yes "${package_specs[@]}"
    else
        printf 'No ordinary Homebrew casks need a routine upgrade.\n'
    fi
}

update_package_manager() {
    local manager="$1" status="$2" available apply_label upgrade_label restricted
    local -a package_specs=() handoff=()
    available="$(printf '%s\n' "$status" | setup_mise exec -- jq -r --arg manager "$manager" '
        .[$manager] | .available == true and (.packages | length > 0)
    ')" || return $?
    [[ "$available" == true ]] || return 0

    select_routine_packages "$status" "$manager" || return $?
    if [[ "$restricted" -eq 1 && ${#package_specs[@]} -eq 0 ]]; then return 0; fi
    case "$manager" in
        brew|brew-cask)
            if [[ "$manager" == brew ]]; then
                apply_label="new Homebrew formulae"
                upgrade_label="Homebrew formulae"
            else
                apply_label="new Homebrew casks"
                upgrade_label="Homebrew casks"
                handoff=(--terminal-handoff)
            fi
            ;;
        *)
            apply_label="newly declared host packages ($manager)"
            upgrade_label="declared host packages ($manager)"
            # Native Linux managers may need direct terminal access for sudo.
            if [[ "$platform" != Darwin ]]; then handoff=(--terminal-handoff); fi
            ;;
    esac

    if run_stage "$apply_label" ${handoff[@]+"${handoff[@]}"} --package-manager "$manager" \
        routine_packages apply --manager "$manager" --yes ${package_specs[@]+"${package_specs[@]}"}; then
        if [[ "$manager" == brew-cask ]]; then
            run_stage "$upgrade_label" --terminal-handoff --package-manager "$manager" upgrade_homebrew_casks || true
        else
            run_stage "$upgrade_label" ${handoff[@]+"${handoff[@]}"} --package-manager "$manager" \
                routine_packages upgrade --manager "$manager" --yes ${package_specs[@]+"${package_specs[@]}"} || true
        fi
    fi
}

app_store_tool_available() {
    local prefix candidate mise_bin
    if setup_mise which mas >/dev/null 2>&1; then return 0; fi
    # Search the formula before PATH, where an old mise shim can hide it.
    if prefix="$(setup_mise bootstrap packages where brew:mas 2>/dev/null)" && [[ -x "$prefix/bin/mas" ]]; then
        export PATH="$prefix/bin:$PATH"
        return 0
    fi
    mise_bin="$(resolve_mise_bin)" || return $?
    while IFS= read -r candidate; do
        # Native mise rejects shims that dispatch back to itself.
        [[ "$candidate" -ef "$mise_bin" ]] && continue
        if [[ -L "$candidate" ]]; then
            case "$(readlink "$candidate" 2>/dev/null)" in
                mise|*/mise) continue ;;
            esac
        fi
        return 0
    done < <(type -aP mas)
    return 1
}

defer_app_store_tool() {
    app_store_authorized=0
    printf '\nDeferred: the Mac App Store update needs an installed mas tool.\n'
    deferred+=("Mac App Store tool")
    dots_up_emit_notice attention 'The Mac App Store update needs an installed mas tool.'
}

prepare_app_store() {
    local settings="$1" missing_tool=0 mise_version
    if ! app_store_tool_available; then
        missing_tool=1
        setup_exception_holder brew:mas "$SETUP_PROFILE" || return $?
        mise_version="$(setup_mise --version)" || return $?
        # Homebrew formula support follows the selected mise binary, which
        # may be an x64 build even when the machine is Apple silicon.
        if [[ -n "$SETUP_HOLDER" || "$mise_version" != *macos-arm64* ]] ||
           ! setup_mise exec -- jq -en --argjson effective "$settings" '
                $effective.system_packages.managers | . == null or index("brew") != null
            ' >/dev/null; then
            defer_app_store_tool
            return 0
        fi
    fi
    run_stage "Mac App Store authorization" --terminal-handoff authorize_app_store_packages || return 0
    if [[ "$app_store_authorized" -eq 1 && "$missing_tool" -eq 1 ]]; then
        if ! run_stage "Mac App Store tool" prepare_app_store_tool; then
            app_store_authorized=0
        elif ! app_store_tool_available; then
            defer_app_store_tool
        fi
    fi
}

update_app_store() {
    local status="$1" result=0 restricted available
    local -a package_specs=()
    available="$(printf '%s\n' "$status" | setup_mise exec -- jq -r '
        .mas | select((.packages | length) > 0) | .available
    ')" || return $?
    case "$available" in
        true) ;;
        false) defer_app_store_tool; return 0 ;;
        *) return 0 ;;
    esac
    select_routine_packages "$status" mas || return $?
    if [[ "$restricted" -eq 1 && ${#package_specs[@]} -eq 0 ]]; then return 0; fi
    start_app_store_packages ${package_specs[@]+"${package_specs[@]}"} || result=$?
    if [[ "$result" -ne 0 ]]; then
        emit_event "$(event_json --arg id mac-app-store --arg status failed --arg summary "could not start (exit $result)" --argjson code "$result" '{v:1,kind:"app_store_end",id:$id,status:$status,summary:$summary,exit_code:$code}')"
        printf 'Mac App Store updates could not start (exit %s).\n' "$result"
        failures+=("Mac App Store packages")
    fi
}

update_packages() {
    local inventory settings package_scope routine_package_scope manager status bare_status="" store_status=""
    inventory="$(setup_package_inventory)" || return $?
    [[ "$inventory" != '{}' ]] || return 0
    settings="$(setup_mise settings ls --all --json system_packages)" || return $?
    package_scope="$(setup_package_scope "$inventory" "$settings")" || return $?
    routine_package_scope="$(setup_package_scope_without_mas "$package_scope")"
    active_package_scope="$routine_package_scope"
    has_bare_packages="$(printf '%s\n' "$inventory" | setup_mise exec -- jq -r 'if .unprefixed then 1 else 0 end')" || return $?

    if [[ "$platform" == Darwin && ",$package_scope," == *,mas,* ]]; then
        if [[ "$include_mas" -eq 1 ]]; then
            prepare_app_store "$settings" || return $?
            if [[ "$app_store_authorized" -eq 1 ]]; then active_package_scope="$package_scope"; fi
        else
            printf '\nSkipped: Mac App Store updates (use dots up --mas to include them).\n'
            dots_up_emit_notice info 'Mac App Store updates intentionally skipped; use --mas to include them.'
        fi
    fi

    if [[ "$has_bare_packages" -eq 1 && -n "$active_package_scope" ]]; then
        bare_status="$(package_status "$active_package_scope")" || return $?
    fi
    for manager in ${routine_package_scope//,/ }; do
        if [[ "$has_bare_packages" -eq 1 ]]; then
            status="$bare_status"
        elif ! status="$(package_status "$manager")"; then
            setup_error "could not inspect $manager packages"
            failures+=("$manager package status")
            dots_up_emit_notice error "Could not inspect $manager packages"
            continue
        fi
        if ! update_package_manager "$manager" "$status"; then
            failures+=("$manager package selection")
            dots_up_emit_notice error "Could not select $manager packages for update"
        fi
    done
    if [[ "$app_store_authorized" -eq 1 ]]; then
        if [[ "$has_bare_packages" -eq 1 ]]; then
            store_status="$bare_status"
        else
            store_status="$(package_status mas)" || return $?
        fi
        update_app_store "$store_status" || return $?
    fi
}

platform="$(uname -s 2>/dev/null || true)"
if ! update_packages; then
    setup_error 'could not determine declared host packages'
    failures+=("host package inventory")
    dots_up_emit_notice error 'Could not determine declared host packages'
fi

# Upgrade declared tools without pruning; tools pinned to a revision keep it.
upgrade_declared_tools() {
    local tool_state pinned_tools tool retained=""
    local -a upgrade_args=(upgrade --no-prune)
    tool_state="$(setup_mise ls --current --json)" || return $?
    pinned_tools="$(printf '%s' "$tool_state" | setup_mise exec -- jq -r '
        to_entries[]
        | select(.value | length > 0)
        | select(all(.value[]; (.requested_version // "" | startswith("rev:"))))
        | .key
    ')" || return $?
    if [[ -n "$pinned_tools" ]]; then
        while IFS= read -r tool; do
            upgrade_args+=(--exclude "$tool")
            retained="${retained}${retained:+, }${tool}"
        done <<< "$pinned_tools"
        printf 'Retaining configured revision pins: %s\n' "$retained"
    fi
    setup_mise "${upgrade_args[@]}"
}

# Hooks learn whether the tools stages succeeded.
export DOTS_TOOLS_OK=0 DOTS_TOOLS_UPGRADED=0
# Explicit package stages already report package state. mise install's
# separate missing-package hint would query managers again, including MAS.
if MISE_DISABLE_HINTS="${MISE_DISABLE_HINTS:+$MISE_DISABLE_HINTS,}system_packages_missing"     run_stage "newly declared mise tools" setup_mise install; then
    DOTS_TOOLS_OK=1
    if run_stage "declared mise tools" upgrade_declared_tools; then DOTS_TOOLS_UPGRADED=1; fi
fi

run_exception() {
    local name="$1" script_path="$2" flags="$3"
    if setup_exception_has_flag "$flags" install-only; then
        run_stage "installer exception: $name" --changes setup_mise exec -- "$script_path" --install-only || true
    else
        run_stage "installer exception: $name" --changes setup_mise exec -- "$script_path" || true
    fi
}

if ! setup_each_exception run_exception; then
    failures+=("installer exception manifest")
fi

# Configuration hooks (dots/hooks/update.d) run after installer exceptions, in
# name order, each as its own stage with this run's stdin; a failed hook does
# not stop later ones. An invalid hook name runs none of them.
if hook_list="$(setup_list_hooks "$SETUP_ROOT/dots/hooks/update.d")"; then
    # Read the list on descriptor 9 so each hook keeps this run's stdin.
    while IFS=$'\t' read -r -u 9 hook_label hook_path; do
        [[ -z "$hook_path" ]] || run_stage "$hook_label" --hook setup_mise exec -- "$hook_path" 9<&- || true
    done 9<<< "$hook_list"
else
    failures+=("update hooks")
fi

if [[ -n "$app_store_pid" ]]; then
    run_stage "Mac App Store result" finish_app_store_packages || true
fi

# Whether mise may update itself. A package manager (Homebrew, a distribution)
# marks its mise with a file next to the binary, and mise then refuses
# self-update; check the same places mise does (mise src/env.rs), relative to
# the parent of the real binary's directory, and honor its override variable.
mise_self_update_available() {
    local base marker
    case "${MISE_SELF_UPDATE_AVAILABLE:-}" in
        1|true|yes) return 0 ;;
        0|false|no) return 1 ;;
    esac
    base="$(dots_manager_home_of "$(resolve_mise_bin)")" || return 0
    for marker in lib/.disable-self-update lib/mise/.disable-self-update lib64/mise/.disable-self-update \
        lib/mise-self-update-instructions.toml lib/mise/mise-self-update-instructions.toml lib64/mise/mise-self-update-instructions.toml; do
        [[ ! -e "$base/$marker" ]] || return 1
    done
    [[ -z "${MISE_SELF_UPDATE_INSTRUCTIONS:-}" ]]
}

# Standalone mise updates last; a package-managed mise updates with its package.
if mise_self_update_available; then
    run_stage "standalone mise" setup_mise self-update --yes || true
else
    printf '\nSkipped: standalone mise is updated by the package manager that installed it.\n'
    dots_up_emit_notice info 'Standalone mise skipped; the package manager that installed mise updates it.'
fi

# dots updates itself only when the configuration declares it (a mise tool or
# a Homebrew formula) and a stage above installed a new version; this run
# finishes on the old one. A checkout is never updated by dots up.
report_manager_update() {
    local installed home before after
    before="$(dots_manager_version "$DOTS_HOME")"
    if [[ "$(dots_manager_installer "$DOTS_HOME")" == checkout ]]; then
        printf 'dots %s runs from a checkout; update it with git.\n' "$before"
        return 0
    fi
    installed="$(setup_mise which dots 2>/dev/null || command -v dots 2>/dev/null || true)"
    home=""
    [[ -z "$installed" ]] || home="$(dots_manager_home_of "$installed" 2>/dev/null || true)"
    if [[ -z "$home" || "$home" == "$DOTS_HOME" || ! -f "$home/lib/dots-manager.sh" ]]; then
        printf 'dots %s is current.\n' "$before"
        return 0
    fi
    after="$(dots_manager_version "$home")"
    if [[ "$after" == "$before" ]]; then
        printf 'dots %s is current.\n' "$before"
        return 0
    fi
    printf 'dots %s -> %s, used from the next run.\n' "$before" "$after"
    [[ -z "${DOTS_CHANGES:-}" ]] || printf 'dots\t%s\t%s\n' "$before" "$after" >> "$DOTS_CHANGES"
    dots_skill_refresh "$home"
}
run_stage "dots manager" --changes report_manager_update || true

if ! run_stage 'Post-update settings checkpoint' settings_checkpoint; then
    setup_error "post-update settings checkpoint failed"
fi

if [[ -n "${DOTS_SOURCE_SYNC_ATTENTION:-}" ]]; then
    printf '\nSource sync needs attention:\n%s\n' "$DOTS_SOURCE_SYNC_ATTENTION"
    [[ -z "${DOTS_UP_RUN_DIR:-}" ]] || printf 'Full log: %s\n' "$DOTS_UP_RUN_DIR/stages/source-sync.log"
    printf 'Next: fix what the sync output says, then run dots sync; %s explains every line\n' "$DOTS_HOME/docs/sync.md"
    deferred+=("source sync")
fi
if [[ "${#attention_logs[@]}" -gt 0 ]]; then
    printf '\nLogs of the steps that need attention:\n'
    printf '  %s\n' "${attention_logs[@]}"
fi
if [[ "${#failures[@]}" -eq 0 ]]; then
    if [[ "${#deferred[@]}" -gt 0 ]]; then
        printf '\nUpdate report: completed; needs attention: '
        printf '%s; ' "${deferred[@]}"
        printf '\n'
        exit 0
    fi
    printf '\nUpdate report: completed; no updater failures.\n'
    exit 0
fi

printf '\nUpdate report: failures: '
printf '%s; ' "${failures[@]}"
printf '\n'
exit 1
