#!/usr/bin/env bash
set -euo pipefail

case "${RUNNER_OS:-}" in
  Linux)
    packages=()
    for tool in fish zsh jq rsync; do
      if ! command -v "$tool" >/dev/null; then
        packages+=("$tool")
      fi
    done
    if (( ${#packages[@]} )); then
      sudo apt-get install -y -qq --no-install-recommends "${packages[@]}" || {
        sudo apt-get update -qq
        sudo apt-get install -y -qq --no-install-recommends "${packages[@]}"
      }
    fi
    ;;
  macOS)
    if ! command -v fish >/dev/null; then
      HOMEBREW_NO_AUTO_UPDATE=1 brew install fish
    fi
    ;;
esac
