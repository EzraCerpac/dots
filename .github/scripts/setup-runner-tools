#!/usr/bin/env bash
set -euo pipefail

case "${RUNNER_OS:-}" in
  Linux)
    packages=()
    for tool in zsh jq rsync; do
      if ! command -v "$tool" >/dev/null; then
        packages+=("$tool")
      fi
    done
    if (( ${#packages[@]} )); then
      sudo apt-get install -y -qq --no-install-recommends "${packages[@]}" || {
        sudo apt-get update -qq
        sudo apt-get install -y -qq --no-install-recommends "${packages[@]}"
      }
    fi
    ;;
esac
