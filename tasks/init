#!/usr/bin/env bash
# Create a minimal dots configuration in DIR without overwriting anything:
#   dots init [DIR]
# config.toml gets the [vars] settings dots requires when they are absent, and
# DIR/dots/ gets the hook, command and exception layout with the manager's
# templates (DOTS_HOME/init), and DIR/.gitleaks.toml and DIR/.gitignore the
# secret-scan and local-file rules dots sync needs. Safe to rerun: existing
# files are left alone.
set -euo pipefail

templates="${DOTS_HOME:?run through dots}/init"
case $# in
    0) dir="${DOTS_ROOT:?run through dots}" ;;
    1) dir="$1" ;;
    *) echo 'usage: dots init [DIR]' >&2; exit 2 ;;
esac
case "$dir" in
    -h|--help) echo 'usage: dots init [DIR]   Create a minimal dots configuration in DIR (default: DOTS_ROOT)'; exit 0 ;;
    -*) echo 'usage: dots init [DIR]' >&2; exit 2 ;;
esac

report() { printf '%-8s %s\n' "$1" "$2"; }

make_dir() {
    if [[ -d "$dir/$1" ]]; then report kept "$1/"; else mkdir -p "$dir/$1"; report created "$1/"; fi
}

# copy_template TARGET [TEMPLATE]: TEMPLATE defaults to TARGET without dots/.
copy_template() {
    if [[ -e "$dir/$1" || -L "$dir/$1" ]]; then
        report kept "$1"
    else
        cp "$templates/${2:-${1#dots/}}" "$dir/$1"
        report created "$1"
    fi
}

if [[ ! -d "$dir" ]]; then
    mkdir -p "$dir"
    report created "$dir/"
fi
dir="$(cd "$dir" && pwd -P)"
printf 'Configuration: %s\n' "$dir"

source "$DOTS_HOME/lib/mise-bin.sh"
source "$DOTS_HOME/lib/mise-config.sh"

init_config_hints() {
    if [[ $# -eq 0 ]] || ! mise_config_file "$1" get "$2" 'vars."dots_source_repo"' >/dev/null 2>&1; then
        printf '%s\n' '# dots_source_repo = "OWNER/NAME"   # GitHub repository of this configuration (sync, publish)'
    fi
    if [[ $# -eq 0 ]] || ! mise_config_file "$1" get "$2" 'vars."dots_state_repo"' >/dev/null 2>&1; then
        printf '%s\n' '# dots_state_repo = "OWNER/NAME"    # private settings history (restore, bootstrap)'
    fi
}

init_config() (
    local config candidate mise hints
    config="$(mise_config_target "$dir/config.toml")" || return $?
    if [[ -f "$config" ]]; then
        mise="${DOTS_MISE_BIN:-}"
        [[ -x "$mise" ]] || mise="$(resolve_mise_bin)" || return $?
        mise_config_file "$mise" get "$config" >/dev/null || return $?
        if mise_config_file "$mise" get "$config" 'vars."dots_profiles"' >/dev/null 2>&1; then
            report kept 'config.toml [vars] dots_profiles'
            return 0
        fi
    fi

    staging="$(mktemp -d "$(dirname "$config")/.dots-init.XXXXXX")" || return 1
    trap 'rm -rf "$staging"' EXIT
    candidate="$staging/config.toml"
    if [[ -f "$config" ]]; then
        mise_config_copy "$config" "$candidate" || return $?
        mise_config_file "$mise" set "$candidate" --type string 'vars."dots_profiles"' default || return $?
        hints="$(init_config_hints "$mise" "$candidate")" || return $?
        if [[ -n "$hints" ]]; then
            printf '\n# Copy these optional settings into [vars].\n%s\n' "$hints" >> "$candidate" || return $?
        fi
        mise_config_file "$mise" get "$candidate" >/dev/null || return $?
        mise_config_mode "$config" "$candidate" 644 || return $?
        mise_config_install "$config" "$candidate" || return $?
        report added 'config.toml [vars] dots_profiles'
    else
        cat > "$candidate" <<'EOF' || return $?
[vars]
# dots settings (see dots/README.md). mise vars are strings; lists are space-separated words.
# Profiles this configuration selects with mise -E; each may have a config.<profile>.toml.
dots_profiles = "default"
EOF
        init_config_hints >> "$candidate" || return $?
        mise_config_install "$config" "$candidate" || return $?
        report created 'config.toml with [vars] dots_profiles'
    fi
)
init_config

for directory in dots dots/hooks dots/hooks/update.d dots/hooks/bootstrap.d dots/commands dots/exceptions; do
    make_dir "$directory"
done
for file in dots/README.md dots/exceptions.tsv dots/retired-dotfiles dots/retired-declarations; do
    copy_template "$file"
done
# dots sync scans every snapshot with the configuration's gitleaks rules and
# refuses to share machine-local files, which .gitignore must exclude.
copy_template .gitleaks.toml gitleaks.toml
copy_template .gitignore gitignore
