#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    printf '%s\n' 'usage: tests/support/oracle-probe /absolute/path/to/bin/dots' >&2
    exit 2
fi
oracle=$1
case "$oracle" in
    /*/dots) ;;
    *) printf '%s\n' 'oracle-probe: expected an absolute path to bin/dots' >&2; exit 2 ;;
esac
renderer=${oracle%/*}/dots-up
if [ ! -f "$oracle" ] || [ ! -x "$oracle" ] || [ ! -f "$renderer" ] || [ ! -x "$renderer" ]; then
    printf '%s\n' 'oracle-probe: unpack the archive with both executables' >&2
    exit 2
fi

# Use a fresh directory in the system temp area, independent of caller TMPDIR.
umask 077
fixture=$(/usr/bin/mktemp -d /tmp/dots-oracle-probe.XXXXXXXX)
trap '/bin/rm -rf -- "$fixture"' EXIT
trap 'exit 1' HUP INT TERM
base=$(cd -P -- "$fixture" && pwd -P)
caller_home=$(cd -P -- "${HOME:-/}" 2>/dev/null && pwd -P) || exit 2
if [ "$base" = "$caller_home" ] || [ "$base/home" = "$caller_home" ]; then
    printf '%s\n' 'oracle-probe: refusing to use the caller HOME' >&2
    exit 2
fi
mkdir "$base/home" "$base/config" "$base/tmp"
cd "$base/config"

probe() {
    /usr/bin/env -i PATH="${PATH:-/usr/bin:/bin}" \
        HOME="$base/home" TMPDIR="$base/tmp" \
        XDG_CONFIG_HOME="$base/xdg-config" XDG_DATA_HOME="$base/xdg-data" \
        XDG_STATE_HOME="$base/xdg-state" XDG_CACHE_HOME="$base/xdg-cache" \
        CODEX_HOME="$base/home/.codex" CLAUDE_CONFIG_DIR="$base/home/.claude" \
        DOTS_ROOT="$base/config" DOTS_SKILL_LINKS=0 \
        MISE_CONFIG_DIR="$base/config" MISE_SYSTEM_CONFIG_DIR="$base/mise-system/config" \
        MISE_DATA_DIR="$base/mise/data" MISE_CACHE_DIR="$base/mise/cache" \
        MISE_STATE_DIR="$base/mise/state" MISE_TMP_DIR="$base/mise/tmp" \
        MISE_INSTALLS_DIR="$base/mise/data/installs" MISE_INSTALL_STORE_DIR="$base/mise/data/store" \
        MISE_DOWNLOADS_DIR="$base/mise/data/downloads" MISE_PLUGINS_DIR="$base/mise/data/plugins" \
        MISE_SHIMS_DIR="$base/mise/data/shims" MISE_SYSTEM_DATA_DIR="$base/mise-system/data" \
        MISE_SYSTEM_INSTALLS_DIR="$base/mise-system/data/installs" \
        MISE_SYSTEM_PLUGINS_DIRS="$base/mise-system/data/plugins" \
        MISE_SYSTEM_SHIMS_DIR="$base/mise-system/data/shims" \
        MISE_CEILING_PATHS="$base" GIT_CONFIG_NOSYSTEM=1 \
        "$@"
}

probe "$oracle" --version
probe "$renderer" --capabilities
