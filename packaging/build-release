#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
root=$(pwd -P)
version=$(sed -n 's/^version = "\([^"]*\)"$/\1/p' Cargo.toml)
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-.+][0-9A-Za-z.-]+)?$ ]]
target=${1:?usage: packaging/build-release TARGET|assemble OUTDIR}
out=${2:?missing output directory}
mkdir -p "$out"
out=$(cd "$out" && pwd -P)

if [[ "$target" == assemble ]]; then
    cd "$out"
    for platform in darwin-arm64 darwin-amd64 linux-arm64 linux-amd64; do
        archive="dots-$version-$platform.tar.gz"
        # Validate the checksum against the exact filename verified on its native runner.
        read -r sum name < "$archive.sha256"
        [[ "$sum" =~ ^[0-9a-f]{64}$ && "$name" == "$archive" ]]
        printf '%s  %s\n' "$sum" "$archive"
    done > SHA256SUMS
    shasum -a 256 -c SHA256SUMS
    awk -v version="$version" '
        NR == FNR {
            n = split($2, fields, "-")
            sub(/[.]tar[.]gz$/, "", fields[n])
            sums[fields[n-1] "-" fields[n]] = $1
            next
        }
        /^  version "/ { $0 = "  version \"" version "\"" }
        /url "/ { gsub(/@VERSION@/, version) }
        /sha256 "/ && ($NF in sums) {
            sub(/"[0-9a-f]+"/, "\"" sums[$NF] "\"")
            seen++
        }
        { print }
        END { if (seen != 4) exit 1 }
    ' SHA256SUMS "$root/packaging/homebrew/dots.rb" > dots.rb
    ruby -c dots.rb
    exit
fi

case "$target:$(uname -s):$(uname -m)" in
    aarch64-apple-darwin:Darwin:arm64) platform=darwin-arm64; machine=arm64 ;;
    x86_64-apple-darwin:Darwin:x86_64) platform=darwin-amd64; machine=x86_64 ;;
    aarch64-unknown-linux-musl:Linux:aarch64) platform=linux-arm64; machine=AArch64 ;;
    x86_64-unknown-linux-musl:Linux:x86_64) platform=linux-amd64; machine='Advanced Micro Devices X86-64' ;;
    *) echo "Expected a native build runner for $target" >&2; exit 2 ;;
esac

target_dir=${CARGO_TARGET_DIR:-target}
.mise/rust-cargo build --release --locked --target "$target" --target-dir "$target_dir" --bin dots
binary="$target_dir/$target/release/dots"
stage=$(mktemp -d "${TMPDIR:-/tmp}/dots-release.XXXXXXXX")
trap 'rm -rf -- "$stage"' EXIT
mkdir -p "$stage/tree/bin" "$stage/unpacked" "$stage/home" "$stage/tmp"
install -m 0755 "$binary" "$stage/tree/bin/dots"
archive="dots-$version-$platform.tar.gz"
COPYFILE_DISABLE=1 tar --format=ustar -czf "$out/$archive" -C "$stage/tree" bin/dots

[[ "$(tar -tzf "$out/$archive")" == bin/dots ]]
[[ "$(tar -tvzf "$out/$archive" | awk 'NR == 1 { print $1 }')" == -rwxr-xr-x ]]
tar -xzf "$out/$archive" -C "$stage/unpacked"
dots="$stage/unpacked/bin/dots"
cmp "$binary" "$dots"
if [[ "$platform" == linux-* ]]; then
    export LC_ALL=C
    [[ "$(readelf -hW "$dots" | sed -n 's/^ *Class: *//p')" == ELF64 ]]
    [[ "$(readelf -hW "$dots" | sed -n 's/^ *Machine: *//p')" == "$machine" ]]
    readelf -lW "$dots" > "$stage/program-headers"
    readelf -dW "$dots" > "$stage/dynamic"
    if grep -Eq '^ *INTERP[[:space:]]' "$stage/program-headers" || grep -Fq '(NEEDED)' "$stage/dynamic"; then
        echo "$archive must have no ELF interpreter or shared-library dependencies" >&2
        exit 1
    fi
    printf 'Verified %s: ELF64 %s, no PT_INTERP or DT_NEEDED\n' "$archive" "$machine"
else
    [[ "$(lipo -archs "$dots")" == "$machine" ]]
fi

actual=$(cd "$stage" && env -i PATH=/usr/bin:/bin     HOME="$stage/home" TMPDIR="$stage/tmp" XDG_CONFIG_HOME="$stage/config"     XDG_CACHE_HOME="$stage/cache" XDG_DATA_HOME="$stage/data" XDG_STATE_HOME="$stage/state"     CODEX_HOME="$stage/home/.codex" CLAUDE_CONFIG_DIR="$stage/home/.claude"     DOTS_SKILL_LINKS=0 "$dots" --version)
[[ "$actual" == "dots $version (other)" ]]
(cd "$out" && shasum -a 256 "$archive" > "$archive.sha256")
printf 'Verified %s: %s\n' "$archive" "$actual"
