#!/usr/bin/env bash
set -euo pipefail

prefix=$1
github_token=${GITHUB_TOKEN-}
unset GITHUB_TOKEN GH_TOKEN
packaged_git=$(command -v git)
git --version | awk -F '[ .]+' 'END {exit !($3+0 > 2 || ($3+0 == 2 && $4+0 >= 43))}' || {
  echo 'Native scenarios require Git 2.43 or newer' >&2
  exit 1
}
age_version=1.3.2
jj_version=0.47.1
gitleaks_version=8.30.1

case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) mise_platform=linux-x64-musl ;;
  Linux-aarch64) mise_platform=linux-arm64-musl ;;
  Darwin-x86_64) mise_platform=macos-x64 ;;
  Darwin-arm64) mise_platform=macos-arm64 ;;
  *) echo 'Unsupported scenario tools platform' >&2; exit 2 ;;
esac

mkdir -p "$prefix/bin"
scratch=$(mktemp -d "$prefix/setup.XXXXXXXX")
trap 'rm -rf -- "$scratch"' EXIT
cd "$scratch"

mise="$prefix/bin/mise"
release="mise-$MISE_VERSION-$mise_platform.tar.gz"
curl -fsSL --retry 3 "https://github.com/jdx/mise/releases/download/$MISE_VERSION/$release" -o "$release"
tar -xzf "$release" mise/bin/mise
install -m 0755 mise/bin/mise "$mise"
# Use the oracle's mise backends, then expose executables independent of mise's state.
provision_mise() {
  env -i PATH="$PATH" HOME="$scratch/install-home" \
    XDG_CONFIG_HOME="$scratch/install-config" XDG_DATA_HOME="$scratch/install-data" \
    XDG_CACHE_HOME="$scratch/install-cache" XDG_STATE_HOME="$scratch/install-state" \
    MISE_SYSTEM_CONFIG_DIR="$scratch/system/config" MISE_SYSTEM_DATA_DIR="$scratch/system/data" \
    MISE_CEILING_PATHS="$scratch" MISE_YES=1 GITHUB_TOKEN="$github_token" \
    "$mise" "$@"
}

test "$(provision_mise --version | cut -d ' ' -f 1)" = "${MISE_VERSION#v}"
provision_mise install "age@$age_version" "jj@$jj_version" "gitleaks@$gitleaks_version"
age_bin=$(provision_mise which age --tool "age@$age_version")
for tool in age age-keygen; do
  install -m 0755 "${age_bin%/*}/$tool" "$prefix/bin/$tool"
done
for spec in "jj@$jj_version" "gitleaks@$gitleaks_version"; do
  tool=${spec%@*}
  install -m 0755 "$(provision_mise which "$tool" --tool "$spec")" "$prefix/bin/$tool"
done

fish_version=4.9.3
case "$mise_platform" in
  linux-x64-musl)
    fish_asset=-linux-x86_64.tar.xz
    fish_sha=8f643d10ad1abb0ef7072764c01ceb5cf61b2d373fda400cf60f0bad69b7e095 ;;
  linux-arm64-musl)
    fish_asset=-linux-aarch64.tar.xz
    fish_sha=57349f0111728c64b703a84e611aa97ff4d1fa8466385d64e67bd5bc3ffa49fc ;;
  macos-*)
    fish_asset=.app.zip
    fish_sha=3619fa92d540ed0dff4816594429290550d21b92226e0523457e5f0242c5e9a8 ;;
esac
fish_archive="fish-$fish_version$fish_asset"
curl -fsSL --retry 3 "https://github.com/fish-shell/fish-shell/releases/download/$fish_version/$fish_archive" -o "$fish_archive"
printf '%s  %s\n' "$fish_sha" "$fish_archive" | shasum -a 256 -c
if [[ "$fish_asset" == .app.zip ]]; then
  # The upstream app carries a relocatable universal CLI and its support files.
  fish_prefix="fish-$fish_version.app/Contents/Resources/base/usr/local"
  unzip -q "$fish_archive" "$fish_prefix/*"
  mv "$fish_prefix" "$prefix/fish"
else
  mkdir -p "$prefix/fish/bin"
  tar -xJf "$fish_archive" -C "$prefix/fish/bin" fish
fi
"$prefix/fish/bin/fish" --version

# Prove fixture PATH still works when HOME and mise state are replaced,
# including when a library case launches mise and then a child on that PATH.
mkdir "$scratch/home" "$scratch/tmp"
env -i PATH="$prefix/bin:$PATH" HOME="$scratch/home" TMPDIR="$scratch/tmp" \
  XDG_CONFIG_HOME="$scratch/config" XDG_CACHE_HOME="$scratch/cache" \
  XDG_DATA_HOME="$scratch/data" XDG_STATE_HOME="$scratch/state" \
  CODEX_HOME="$scratch/codex" CLAUDE_CONFIG_DIR="$scratch/claude" \
  MISE_CONFIG_DIR="$scratch/config/mise" MISE_SYSTEM_CONFIG_DIR="$scratch/system/config" \
  MISE_SYSTEM_DATA_DIR="$scratch/system/data" MISE_CEILING_PATHS="$scratch" \
  MISE_OFFLINE=1 MISE_AUTO_INSTALL=0 MISE_EXEC_AUTO_INSTALL=0 \
  GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_ALLOW_PROTOCOL=file \
  JJ_CONFIG="$scratch/jj.toml" \
  "$mise" exec -- sh -eu -s "$prefix" "$packaged_git" <<'SH'
for tool in mise age age-keygen jj gitleaks; do
  test "$(command -v "$tool")" = "$1/bin/$tool"
  "$tool" --version
done
test "$(command -v git)" = "$2"
git --version
test -x "$(git --exec-path)/git-remote-http"
python3 --version
jq --version
git init -q --bare --initial-branch=main "$TMPDIR/remote.git"
git ls-remote "$TMPDIR/remote.git"
SH
